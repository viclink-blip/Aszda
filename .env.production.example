# ASZDA Studio: production settings for docker-compose.prod.yml (one DigitalOcean Droplet).
# Copy to .env.production on the server and fill in every value. NEVER commit .env.production.
# Comments must be on their own line (Docker reads `KEY=   # note` as the value "# note").
# Generate secrets with:  openssl rand -base64 48

# ---- Your address -------------------------------------------------------------
# The domain or subdomain pointing at the Droplet, without https:// (e.g. studio.aszda.com)
ASZDA_DOMAIN=
# Email for Let's Encrypt certificate notices
ACME_EMAIL=
# Same domain with https://
ASZDA_FRONTEND_URL=
ASZDA_CORS_ORIGINS=

# ---- Secrets (each one different and random) ------------------------------------
ASZDA_SECRET_KEY=
ASZDA_JWT_SECRET_KEY=
POSTGRES_PASSWORD=

# ---- Email (required in production: verification and password-reset emails) ----
# Any SMTP provider, e.g. Brevo, Mailgun, Postmark, Amazon SES. Set SPF/DKIM on your domain.
ASZDA_MAIL_BACKEND=smtp
ASZDA_MAIL_FROM=ASZDA Studio <no-reply@your-domain>
ASZDA_SMTP_HOST=
ASZDA_SMTP_PORT=587
ASZDA_SMTP_USERNAME=
ASZDA_SMTP_PASSWORD=
ASZDA_SMTP_USE_TLS=true

# ---- Media storage: DigitalOcean Spaces (private bucket) -----------------------
ASZDA_STORAGE_BACKEND=s3
# Bucket name, e.g. aszda-media
ASZDA_S3_BUCKET=
# Spaces region, e.g. fra1, ams3, nyc3, sgp1
ASZDA_S3_REGION=
# https://<region>.digitaloceanspaces.com
ASZDA_S3_ENDPOINT_URL=
# Spaces access key (Control Panel -> Spaces Object Storage -> Access Keys)
ASZDA_S3_ACCESS_KEY_ID=
ASZDA_S3_SECRET_ACCESS_KEY=
ASZDA_MAX_UPLOAD_MB=50

# ---- Credits and limits ------------------------------------------------------------
ASZDA_PRICING_FILE=
ASZDA_SIGNUP_CREDIT_GRANT=50
ASZDA_SIGNUP_GRANT_DAILY_CAP=200
ASZDA_REQUIRE_VERIFIED_EMAIL=true

# ---- AI providers (server only) -------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RUNWAYML_API_SECRET=
GEMINI_API_KEY=
ASZDA_GOOGLE_VIDEO_MODELS=
# Gemini image models (list yours with: flask --app wsgi aszda google-models)
ASZDA_GOOGLE_IMAGE_MODELS=
ASZDA_GOOGLE_IMAGE_MODEL=

# ---- Payments (keep OFF until Paystack confirms USD and it has been tested) --------
ASZDA_USD_TO_KES_REFERENCE_RATE=133
PAYSTACK_SECRET_KEY=
ASZDA_PAYSTACK_USD_ENABLED=false
