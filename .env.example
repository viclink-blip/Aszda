# Comments must be on their own line: Docker Compose would read `KEY=   # note` as the value "# note".
# ASZDA Studio — example environment. Copy to `.env` (backend/.env for local runs,
# or the project root for docker compose) and fill in real values.
# NEVER commit a real .env file. Every value here is a placeholder.
# Full reference: docs/ENVIRONMENT.md

# ---- Core -------------------------------------------------------------------
# development | production
ASZDA_ENV=development
# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ASZDA_SECRET_KEY=replace-with-a-long-random-string
ASZDA_JWT_SECRET_KEY=replace-with-a-different-long-random-string

DATABASE_URL=postgresql+psycopg://aszda:aszda@localhost:5432/aszda
REDIS_URL=redis://localhost:6379/0

# used in email links
ASZDA_FRONTEND_URL=http://localhost:3000
ASZDA_CORS_ORIGINS=http://localhost:3000
# must be true in production (HTTPS)
ASZDA_COOKIE_SECURE=false
# number of reverse proxies in front of the API
ASZDA_TRUSTED_PROXIES=0

# Development only: run generation jobs inside the API process (no worker needed).
ASZDA_CELERY_EAGER=false

# ---- Email ------------------------------------------------------------------
# console (prints to log) | smtp
ASZDA_MAIL_BACKEND=console
ASZDA_MAIL_FROM=ASZDA <no-reply@your-domain.example>
ASZDA_SMTP_HOST=
ASZDA_SMTP_PORT=587
ASZDA_SMTP_USERNAME=
ASZDA_SMTP_PASSWORD=
ASZDA_SMTP_USE_TLS=true

# ---- Storage ----------------------------------------------------------------
# local | s3
ASZDA_STORAGE_BACKEND=local
ASZDA_MAX_UPLOAD_MB=50
ASZDA_SIGNED_URL_TTL_SECONDS=900
ASZDA_S3_BUCKET=
ASZDA_S3_REGION=
# for S3-compatible services (R2, MinIO, Wasabi...)
ASZDA_S3_ENDPOINT_URL=
ASZDA_S3_ACCESS_KEY_ID=
ASZDA_S3_SECRET_ACCESS_KEY=

# ---- Credits and limits -----------------------------------------------------
# e.g. ./pricing.json (see backend/pricing.example.json)
ASZDA_PRICING_FILE=
# one-time free credits when a new account confirms its email
ASZDA_SIGNUP_CREDIT_GRANT=50
# abuse guard: max sign-up grants per UTC day (0 = no cap)
ASZDA_SIGNUP_GRANT_DAILY_CAP=200
ASZDA_MAX_CREDITS_PER_JOB=500
ASZDA_MAX_ACTIVE_JOBS_PER_USER=3
ASZDA_DAILY_JOB_LIMIT=50
ASZDA_MONTHLY_CREDIT_LIMIT=5000
ASZDA_REQUIRE_VERIFIED_EMAIL=true

# ---- Rate limiting ----------------------------------------------------------
# use redis://... in production
ASZDA_RATELIMIT_STORAGE_URI=memory://

# ---- Billing (docs/BILLING.md) ---------------------------------------------
# fixed reference rate for KES amounts shown next to USD prices
ASZDA_USD_TO_KES_REFERENCE_RATE=133
# sk_test_... first; never commit a real key
PAYSTACK_SECRET_KEY=
# true only after Paystack confirms USD for the account
ASZDA_PAYSTACK_USD_ENABLED=false

# ---- AI providers (server-side only; never put these in frontend code) -----
# Setup per provider: docs/PROVIDERS.md. A provider without its key simply shows as
# "not configured"; nothing crashes. Each model also needs a credit price (Admin -> Pricing)
# before it can be used.
#
# Anthropic (text, scripts, AI Film Director planning)
ANTHROPIC_API_KEY=
# offered models; the first is the default
ASZDA_ANTHROPIC_TEXT_MODELS=claude-opus-5-5
#
# OpenAI (voice and images)
OPENAI_API_KEY=
# default voice model (all OpenAI TTS models shut down 2027-01-06)
ASZDA_OPENAI_TTS_MODEL=gpt-4o-mini-tts
ASZDA_OPENAI_IMAGE_MODELS=gpt-image-2.5-sunburst,gpt-image-2
ASZDA_OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
#
# Runway (video, image-to-video)
RUNWAYML_API_SECRET=
# gen4.5 | veo3.1_fast
ASZDA_RUNWAY_VIDEO_MODEL=gen4.5
#
# Google Veo (video). Either the Gemini API key...
GEMINI_API_KEY=
# ...or Vertex AI (Google Cloud): set these three and provide Google Cloud credentials
# (GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json inside the container).
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
# Veo model IDs your account can use (no default: check with the admin connection test first).
ASZDA_GOOGLE_VIDEO_MODELS=
ASZDA_GOOGLE_VIDEO_MODEL=
#
# Which provider handles each kind of work when the user does not choose one, and which
# others may stand in when it is not ready (comma-separated, in order).
ASZDA_AI_TEXT_PROVIDER=anthropic
ASZDA_AI_TEXT_FALLBACKS=
ASZDA_AI_IMAGE_PROVIDER=openai
ASZDA_AI_IMAGE_FALLBACKS=
ASZDA_AI_VIDEO_PROVIDER=runway
ASZDA_AI_VIDEO_FALLBACKS=google
ASZDA_AI_VOICE_PROVIDER=openai
ASZDA_AI_VOICE_FALLBACKS=
# switch providers off without removing keys, e.g. google
ASZDA_DISABLED_PROVIDERS=
